# Configuração do Oracle Database MCP Server
# Copie este arquivo para .env e configure de acordo com seu ambiente

# === CONFIGURAÇÃO BÁSICA ===
# Host do servidor Oracle
ORACLE_HOST=host
# Porta do Oracle (padrão 1521)
ORACLE_PORT=port
# Nome do serviço Oracle
ORACLE_SERVICE_NAME=service
# Usuário do banco de dados
ORACLE_USERNAME=user
# Senha do banco de dados
ORACLE_PASSWORD=pass

# === CONFIGURAÇÃO DE POOL DE CONEXÕES ===
# Número mínimo de conexões no pool
ORACLE_POOL_MIN=2
# Número máximo de conexões no pool
ORACLE_POOL_MAX=10
# Incremento de conexões
ORACLE_POOL_INCREMENT=1
# Timeout do pool em segundos
ORACLE_POOL_TIMEOUT=60

# === CONFIGURAÇÃO DE DESEMPENHO ===
# Tamanho do cache de statements
ORACLE_STMT_CACHE_SIZE=30
# Número de linhas a buscar por lote
ORACLE_FETCH_SIZE=100

# === CONFIGURAÇÃO PARA VERSÕES ANTIGAS DO ORACLE ===
# Ativar para Oracle com criptografia antiga (pré-12c)
ORACLE_OLD_CRYPTO=true

# === CONFIGURAÇÃO DO CLIENTE ORACLE ===
# Diretório das bibliotecas do cliente Oracle (opcional)
# ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/19.3/client64/lib

# === CONFIGURAÇÃO ADICIONAL ===
# Variáveis alternativas (compatibilidade)
ORACLE_USER=aygusercrm

# === CONFIGURAÇÃO DE LOGGING ===
# Nível de log (opcional)
# LOG_LEVEL=info

# ============================================================
# === AUTENTICAÇÃO MCP (Bearer Token / API Keys)          ===
# ============================================================

# Habilitar autenticação (padrão: true)
# Definir como "false" APENAS em desenvolvimento local isolado.
MCP_AUTH_ENABLED=true

# --- Chaves de API (formato recomendado para produção) ---
# Lista de hashes SHA-256 (hex) separados por vírgula.
# Para gerar uma chave e seu hash, execute:
#   npm run generate-key
#
# NUNCA armazene as chaves em texto plano neste arquivo em produção.
# Copie apenas o hash (linha "SHA-256 Hash:") para cá.
# MCP_API_KEYS=<hash1>,<hash2>

# --- Chaves em texto plano (uso em desenvolvimento / CI) ---
# As chaves serão hasheadas na inicialização. Comprimento mínimo: 16 chars.
# Em produção prefira MCP_API_KEYS com hashes pré-computados.
# MCP_API_KEYS_PLAIN=minha-chave-secreta-aqui

# --- Rate Limiting ---
# Janela de tempo em milissegundos (default: 60000 = 1 minuto)
MCP_RATE_LIMIT_WINDOW_MS=60000
# Máximo de requisições por janela por IP (default: 100)
MCP_RATE_LIMIT_MAX=100
# Duração do bloqueio após exceder limite, em ms (default: 300000 = 5 min)
MCP_RATE_LIMIT_BLOCK_MS=300000

# --- Uso com clientes MCP ---
# Clientes devem enviar a chave no header:
#   Authorization: Bearer <sua-chave>
# ou:
#   x-api-key: <sua-chave>
