# Configuração do Oracle Database MCP Server
# Copie este arquivo para .env e configure de acordo com seu ambiente

# === CONFIGURAÇÃO BÁSICA ===
# Host do servidor Oracle
ORACLE_HOST=host
# Porta do Oracle (padrão 1521)
ORACLE_PORT=port
# Nome do serviço Oracle
ORACLE_SERVICE_NAME=service
# Usuário do banco de dados
ORACLE_USERNAME=user
# Senha do banco de dados
ORACLE_PASSWORD=pass

# === CONFIGURAÇÃO DE POOL DE CONEXÕES ===
# Número mínimo de conexões no pool
ORACLE_POOL_MIN=2
# Número máximo de conexões no pool
ORACLE_POOL_MAX=10
# Incremento de conexões
ORACLE_POOL_INCREMENT=1
# Timeout do pool em segundos
ORACLE_POOL_TIMEOUT=60

# === CONFIGURAÇÃO DE DESEMPENHO ===
# Tamanho do cache de statements
ORACLE_STMT_CACHE_SIZE=30
# Número de linhas a buscar por lote
ORACLE_FETCH_SIZE=100

# === CONFIGURAÇÃO PARA VERSÕES ANTIGAS DO ORACLE ===
# Ativar para Oracle com criptografia antiga (pré-12c)
ORACLE_OLD_CRYPTO=true

# === CONFIGURAÇÃO DO CLIENTE ORACLE ===
# Diretório das bibliotecas do cliente Oracle (opcional)
# ORACLE_CLIENT_LIB_DIR=/usr/lib/oracle/19.3/client64/lib

# === CONFIGURAÇÃO ADICIONAL ===
# Variáveis alternativas (compatibilidade)
ORACLE_USER=aygusercrm

# === CONFIGURAÇÃO DE LOGGING ===
# Nível de log (opcional)
# LOG_LEVEL=info 